# voiceover-engine settings. Copy this file to .env and fill in the keys.
# The backend reads .env from the project root; on Railway, set the same names as service variables.

# --- API protection ---
# Every request must send this value in the X-API-Key header. The API refuses every request while it is empty.
# Make a long random value, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Sites that may call the API from a browser, comma separated. The test page calls it from its own server instead.
CORS_ORIGINS=http://localhost:3000
# FastAPI's /docs page (it needs no key): on only for local development.
API_DOCS=off

# --- ElevenLabs (the voice) ---
ELEVENLABS_API_KEY=
# The voice must exist in the ElevenLabs account that owns ELEVENLABS_API_KEY (the voice clone, or a voice added to
# that account's library). Empty: rExOvxZPbTNhO480h6cK, the voice the engine was tuned with.
ELEVENLABS_VOICE_ID=
# Empty: eleven_multilingual_v2, the model the voice was tuned and approved with.
ELEVENLABS_MODEL_ID=
# elevenlabs, or mock for silent audio of a realistic length (tests without credits).
TTS_PROVIDER=elevenlabs
# A voice type of config/voice.json: teacher (default), steady or lively.
VOICE_TYPE=teacher
# The leveler evens every phrase and segment to one loudness. "off" to switch it off.
VOICE_LEVELER=
# The pause after each sentence of an explanation: human (default) or even (2.2 s after every sentence).
PAUSE_RHYTHM=

# --- The opening line (off unless a request sends "opening": true or its own "openingLine") ---
OPENING_LINE=Hey guys! This is Ed Roh.
# The approved take of that line (assets/voice) is used when its voice and line match. "off" to always speak it anew.
APPROVED_OPENING=
# Seconds of quiet after the opening line.
OPENING_PAUSE_SECONDS=1.0

# --- Claude (rewrite: true, and mode "content") ---
ANTHROPIC_API_KEY=
# Empty: claude-sonnet-5-5.
ANTHROPIC_MODEL=
# low, medium or high. Empty: medium.
ANTHROPIC_EFFORT=
# Only for a key that is not tied to one workspace.
ANTHROPIC_WORKSPACE_ID=
# The most one job may spend on Claude, in US dollars.
COST_LIMIT_USD=5

# --- Ports for start.sh (local only; Railway sets PORT) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Jobs ---
# Where the jobs' files go. On Railway, mount a volume here.
DATA_DIR=data
# How many jobs make their voice at the same time.
MAX_CONCURRENT_JOBS=1
